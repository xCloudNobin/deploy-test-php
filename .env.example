# PHP taskboard runtime configuration.
# Copy to .env (or export in the platform environment) and adjust values.
# None of these values are secrets; there is nothing sensitive to commit.

# Server
PORT=8080
BIND_HOST=0.0.0.0

# Optional URL prefix when the app is served behind a sub-path (e.g. /app).
# BASE_PATH=/app

# Persistence. DATA_DIR/DATABASE_PATH point at the persistent SQLite file.
# Keep this path on a persistent volume or exposed external database; the app
# never stores permanent data in an ephemeral release directory.
DATA_DIR=./data
DATABASE_PATH=./data/taskboard.db

# Non-sensitive release marker shown in the UI footer via /api/meta.
# scripts/build.sh writes VERSION (git SHA by default) into the build.
BUILD_MARKER=develop

# PHP built-in web server draws the number of worker processes from this
# environment variable (PHP 7.4+). 1 is fine for a small fixture.
PHP_CLI_SERVER_WORKERS=1